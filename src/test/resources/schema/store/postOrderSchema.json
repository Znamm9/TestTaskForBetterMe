{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier for the order"
    },
    "petId": {
      "type": "integer",
      "description": "ID of the pet being ordered"
    },
    "quantity": {
      "type": "integer",
      "description": "Quantity of the pet being ordered"
    },
    "shipDate": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time the order is scheduled to ship (in ISO 8601 format)"
    },
    "status": {
      "type": "string",
      "enum": ["placed", "approved", "delivered"],
      "description": "Order status"
    },
    "complete": {
      "type": "boolean",
      "description": "Indicates whether the order is complete"
    }
  },
  "required": ["id", "petId", "quantity", "shipDate", "status", "complete"],
  "additionalProperties": false
}